From: Igor Todorovski <itodorov@ca.ibm.com>
Date: 2026-08-12
Subject: [PATCH 1/3] z/OS: Cargo.toml patches for cross-compilation

- Workspace Cargo.toml: add [patch.crates-io] for pyo3 (z/OS fork),
  libc (z/OS fork, v0.2.189), and target-lexicon (git main)
- src/rust/Cargo.toml: rename [lib] name "cryptography_rust" -> "_rust"
  so the GOFF DLL internal name is "lib_rust.so" (not "libcryptography_rust.so")
- .cargo/config.toml (cp312 example): link OpenSSL, zoslib, zos_strerror
  and Python side-deck as explicit static archive paths from SERVER_WORKDIR
  (~/rust_bld/rustcross/sysroot/lib/). No dynamic -L search path.
  zoslib is linked statically to avoid dependency on the installed version.
diff --git a/Cargo.toml b/Cargo.toml
index 79ea7aa3c..8e64c014c 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -36,3 +36,12 @@ self_cell = "1"
 
 [profile.release]
 overflow-checks = true
+
+[patch.crates-io]
+pyo3 = { path = "/tmp/pyo3" }
+pyo3-build-config = { path = "/tmp/pyo3/pyo3-build-config" }
+pyo3-ffi = { path = "/tmp/pyo3/pyo3-ffi" }
+pyo3-macros = { path = "/tmp/pyo3/pyo3-macros" }
+pyo3-macros-backend = { path = "/tmp/pyo3/pyo3-macros-backend" }
+target-lexicon = { git = "https://github.com/bytecodealliance/target-lexicon", branch = "main" }
+libc = { path = "/tmp/libc-zos" }
diff --git a/src/rust/Cargo.toml b/src/rust/Cargo.toml
index 878a23d27..5b4b9c47b 100644
--- a/src/rust/Cargo.toml
+++ b/src/rust/Cargo.toml
@@ -29,7 +29,7 @@ self_cell.workspace = true
 pyo3-build-config.workspace = true
 
 [lib]
-name = "cryptography_rust"
+name = "_rust"
 crate-type = ["cdylib"]
 
 [lints.rust]
