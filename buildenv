# bump: cryptography-version /CRYPTOGRAPHY_VERSION="(.*)"/ https://github.com/pyca/cryptography.git|semver:*
CRYPTOGRAPHY_VERSION="50.0.0"

###
### Build control file for the cryptography port
###
### cryptography is a Rust extension linked against OpenSSL and cannot be
### compiled natively on z/OS: there is no native Rust toolchain. Wheels are
### cross-compiled on Linux-on-Power with IBM's Rust cross-compiler targeting
### s390x-ibm-zos and attached to this repo's releases; the port downloads
### them and puts them through the rest of the pipeline unchanged -- retagged,
### imported and exercised on every interpreter, packaged and published.
###
### Same BARE arrangement as fdport and pydantic-coreport. Keeping
### ZOPEN_BUILD_SYSTEM="Python" matters: it is what stages the wheels for the
### wheel index and runs the check once per interpreter. A cross-compiled
### binary nobody loaded is the main risk here, so nothing is published until
### the interpreter it claims to support has actually run crypto with it.
###
### Why this port exists: IBM Open Enterprise SDK for Python bundles
### cryptography 3.3.2 (February 2021), which has 22 known CVEs including
### certificate-validation bypasses. 50.0.0 also satisfies every consumer we
### have been asked for -- paramiko, msal, pyjwt[crypto], requests-pkcs12 and
### snowflake-connector-python (which needs >=46.0.5).
###

export ZOPEN_PROJECT_NAME="cryptography"
export ZOPEN_BUILD_LINE="STABLE"
export ZOPEN_TYPE="BARE"

# Required even though nothing is fetched from it: checkEnv exempts only
# ZOPEN_TYPE=LOCAL, so a BARE port without a URL stops with "Building from
# stable, but ZOPEN_STABLE_URL not specified". getCode returns early for BARE
# and never clones. The upstream org is pyca, not pypa.
export ZOPEN_STABLE_URL="https://github.com/pyca/cryptography.git"
export ZOPEN_STABLE_TAG="${CRYPTOGRAPHY_VERSION}"
# Same reason as the stable URL: the DEV line applies the identical check,
# so an empty value fails a dev build before it starts.
export ZOPEN_DEV_URL="https://github.com/pyca/cryptography.git"

export ZOPEN_STABLE_DEPS="check_python curl"
export ZOPEN_DEV_DEPS="check_python curl"
export ZOPEN_CATEGORIES="development security library"

# openssl and zoslib are linked by the extension, so they must be present at
# run time. Declaring them here makes .depsenv put their lib directories on
# LIBPATH for anything that sources this port's .env.
export ZOPEN_RUNTIME_DEPS="check_python openssl zoslib"

export ZOPEN_BUILD_SYSTEM="Python"
export ZOPEN_BOOTSTRAP="skip"
export ZOPEN_CONFIGURE="skip"
export ZOPEN_COMP="skip"
export ZOPEN_MAKE="zopen_custom_build"

# Interpreters are NOT hardcoded here. zopen-build consults
# ZOPEN_PYTHON_<major>_<minor> (exported by check_python), then python<version>
# on PATH. Setting them in a buildenv overrides that discovery rather than
# supplementing it, and the literal paths are wrong on machines where a version
# is installed somewhere else -- /usr/lpp/IBM/cyp/v3r13 is an empty directory on
# every build agent checked so far.

WHEEL_BASE_URL="https://github.com/zopencommunity/cryptographyport/releases/download/v${CRYPTOGRAPHY_VERSION}"

zopen_get_version() {
  echo "${CRYPTOGRAPHY_VERSION}"
}

# Fetch one prebuilt wheel per interpreter. The native name is used on purpose:
# letting _zopen_python_retag_wheel do the retagging rewrites the filename, the
# WHEEL metadata and RECORD together. Renaming to -none-any by hand leaves the
# internal tag saying os390_<release>_<model>, which is malformed per PEP 427
# and does not self-heal, because retagging treats a -none-any name carrying a
# cp3XY python tag as already done.
zopen_init() {
  mkdir -p wheels || return 1
  for _pv in $(_zopen_python_versions); do
    _tag="cp$(echo "${_pv}" | tr -d '.')"
    _whl="cryptography-${CRYPTOGRAPHY_VERSION}-${_tag}-${_tag}-os390_29_00_8561.whl"
    [ -f "wheels/${_whl}" ] && continue
    printInfo "Fetching ${_whl}"
    if ! curl -fsSL -o "wheels/${_whl}" "${WHEEL_BASE_URL}/${_whl}"; then
      printSoftError "No prebuilt wheel for Python ${_pv} at ${WHEEL_BASE_URL}/${_whl}"
      printSoftError "A Rust extension is built against one CPython ABI and cryptography"
      printSoftError "has no abi3 build, so each interpreter needs its own cross-compile."
      rm -f "wheels/${_whl}"
      return 1
    fi
    # A wheel is a zip; tagging it as text invites conversion on read.
    chtag -b "wheels/${_whl}"
  done
}

# cryptography declares cffi>=2.0.0, and cffi cannot be installed from PyPI on
# z/OS: its sdist needs libffi headers that are not there, so the build fails
# with "No such file or directory: /usr/include/ffi". The interpreters ship
# their own cffi -- 1.17.1 on 3.12, 2.0.0 on 3.13 and 3.14 -- so the venv has to
# be able to see it. zopen-build's own helper creates an isolated venv, which is
# right for a port that builds from source and wrong here.
#
# 3.12's bundled 1.17.1 is below the declared floor, but the extension links
# its own OpenSSL and only needs cffi for a narrow path; verified on-platform
# that 50.0.0 imports and signs correctly against it. If that stops being true
# the check will say so rather than pass quietly.
#
# Seeing system packages also means the interpreter-bundled cryptography 3.3.2
# is importable, so a failed wheel install would silently test the old vulnerable
# version instead. version_matches_label below is what stops that.
_crypto_venv_for() {
  _cv_dir=$(_zopen_python_venv_dir "$1")
  if [ ! -f "${_cv_dir}/bin/activate" ]; then
    printInfo "Creating virtual environment for ${1} in ${_cv_dir} (with system packages)"
    "$(_zopen_python_interpreter_path "$1")" -m venv --system-site-packages "${_cv_dir}" || return 1
  fi
  . "${_cv_dir}/bin/activate" || return 1
  pip install --disable-pip-version-check --quiet setuptools build installer wheel
}

# Stands in for compiling. Everything the Python build system would do is still
# done -- verify the interpreters, create a virtual environment for each, put
# that interpreter's wheel in dist/, retag -- except the compiling itself. The
# per-interpreter venv is not optional: the check phase runs in it and fails
# with "No virtual environment at .venv-3.13" without it.
zopen_custom_build() {
  _zopen_python_verify_interpreters || return 1

  rm -rf dist
  mkdir -p dist || return 1

  for _pv in $(_zopen_python_versions); do
    _crypto_venv_for "${_pv}" || return 1
    _tag="cp$(echo "${_pv}" | tr -d '.')"
    _src="wheels/cryptography-${CRYPTOGRAPHY_VERSION}-${_tag}-${_tag}-os390_29_00_8561.whl"
    if [ ! -f "${_src}" ]; then
      printSoftError "No wheel staged for Python ${_pv}: ${_src}"
      deactivate
      return 1
    fi
    cp "${_src}" dist/ || { deactivate; return 1; }
    printInfo "Staged $(basename "${_src}") for Python ${_pv}"
    deactivate
  done

  # Retag to cp3XY-none-any so a wheel is not pinned to the z/OS release and
  # machine model of the box that produced it. The tag is read from each
  # wheel's own filename, so the interpreter active here does not matter.
  _crypto_venv_for "$(_zopen_python_primary_version)" || return 1
  _zopen_python_retag_wheel
  _rc=$?
  deactivate
  return ${_rc}
}

# Called once per interpreter, with that interpreter's environment active and
# its wheel already installed. Loading the extension and doing real crypto is
# the point: it is the only thing that shows a wheel built off-platform works
# on this one.
zopen_python_test() {
  # pip preserves the mode recorded in the wheel, and these wheels record the
  # extension without an execute bit. z/OS needs it to HFS-load the module:
  # without this the import dies with CEE3512S ... reason code EF076015.
  for _so in $(python -c 'import sysconfig,os;print(sysconfig.get_paths()["platlib"])')/cryptography/hazmat/bindings/*.so; do
    [ -f "${_so}" ] && chmod +x "${_so}"
  done
  CRYPTOGRAPHY_EXPECTED_VERSION="${CRYPTOGRAPHY_VERSION}" python - <<'PYEOF'
import os
import sys

failures = 0
total = 0


def check(label, fn):
    global failures, total
    total += 1
    try:
        fn()
    except Exception as exc:
        print(f"FAILED {label}: {exc}")
        failures += 1
        return
    print(f"PASSED {label}")


import cryptography
from cryptography.fernet import Fernet
from cryptography.hazmat.backends import default_backend
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import ec, padding, rsa
from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes

print(f"cryptography {cryptography.__version__} on Python {sys.version.split()[0]}")

# The extension must be the one that loaded, not a stale copy, and its version
# must match the label. _rust exposes no __version__ of its own in 50.0.0, so
# check the module actually came out of this package and carries real symbols.
def extension_is_loaded():
    from cryptography.hazmat.bindings import _rust
    assert _rust.__file__.endswith(".so"), f"not an extension: {_rust.__file__}"
    assert hasattr(_rust, "ObjectIdentifier"), "extension loaded but exports nothing"


def version_matches_label():
    expected = os.environ.get("CRYPTOGRAPHY_EXPECTED_VERSION")
    if expected:
        assert cryptography.__version__ == expected, (
            f"wheel claims {expected}, package reports {cryptography.__version__}")


def sha256_known_answer():
    d = hashes.Hash(hashes.SHA256(), backend=default_backend())
    d.update(b"hello z/OS")
    assert d.finalize().hex() == (
        "6dc1a19e0cb5f3f43c310e992f8a276fb884d826639af9f6f6b8c3fbbba038e2")


def aes_cbc_roundtrip():
    key, iv = os.urandom(32), os.urandom(16)
    c = Cipher(algorithms.AES(key), modes.CBC(iv))
    enc = c.encryptor()
    ct = enc.update(b"0123456789abcdef") + enc.finalize()
    dec = c.decryptor()
    assert dec.update(ct) + dec.finalize() == b"0123456789abcdef"


def rsa_sign_verify():
    k = rsa.generate_private_key(65537, 2048)
    sig = k.sign(b"test", padding.PKCS1v15(), hashes.SHA256())
    k.public_key().verify(sig, b"test", padding.PKCS1v15(), hashes.SHA256())


def rsa_rejects_bad_signature():
    from cryptography.exceptions import InvalidSignature
    k = rsa.generate_private_key(65537, 2048)
    sig = k.sign(b"test", padding.PKCS1v15(), hashes.SHA256())
    try:
        k.public_key().verify(sig, b"tampered", padding.PKCS1v15(), hashes.SHA256())
    except InvalidSignature:
        return
    raise AssertionError("a bad signature verified")


def ecdsa_sign_verify():
    k = ec.generate_private_key(ec.SECP256R1())
    sig = k.sign(b"test", ec.ECDSA(hashes.SHA256()))
    k.public_key().verify(sig, b"test", ec.ECDSA(hashes.SHA256()))


def fernet_roundtrip():
    f = Fernet(Fernet.generate_key())
    assert f.decrypt(f.encrypt(b"zos")) == b"zos"


check("extension_is_loaded", extension_is_loaded)
check("version_matches_label", version_matches_label)
check("sha256_known_answer", sha256_known_answer)
check("aes_cbc_roundtrip", aes_cbc_roundtrip)
check("rsa_sign_verify", rsa_sign_verify)
check("rsa_rejects_bad_signature", rsa_rejects_bad_signature)
check("ecdsa_sign_verify", ecdsa_sign_verify)
check("fernet_roundtrip", fernet_roundtrip)

print(f"CRYPTO_TOTAL={total}")
print(f"CRYPTO_FAILURES={failures}")
raise SystemExit(1 if failures else 0)
PYEOF
}

zopen_check_results() {
  dir="$1"; pfx="$2"; chk="${dir}/${pfx}_check.log"

  # zopen-build parses "actualFailures:<n>" and "totalTests:<n>" -- colon
  # separated, those exact keys. Anything else and the build stops with
  # "needs to emit an actualFailures:<number> line".
  #
  # Sum across runs: the test runs once per interpreter and every run writes to
  # this one log, so reading a single pair would report a fraction of the
  # checks and hide a failure on one interpreter behind a later pass.
  totalTests=$(grep -oE 'CRYPTO_TOTAL=[0-9]+' "${chk}" 2>/dev/null | cut -d= -f2 | awk '{s+=$1} END {print s+0}')
  actualFailures=$(grep -oE 'CRYPTO_FAILURES=[0-9]+' "${chk}" 2>/dev/null | cut -d= -f2 | awk '{s+=$1} END {print s+0}')

  # A wheel that cannot be imported kills its run before printing any counts,
  # which is exactly the failure this port exists to catch, so an interpreter
  # that started and produced no counts is a failure rather than an absence of
  # results. Never hardcode failures to zero: a check that cannot report a
  # failure is not a check.
  runs=$(grep -c 'CRYPTO_TOTAL=' "${chk}" 2>/dev/null); runs=${runs:-0}
  interpreters=$(grep -c 'Running tests with Python' "${chk}" 2>/dev/null); interpreters=${interpreters:-0}
  if [ "${runs}" -lt "${interpreters}" ]; then
    actualFailures=$((actualFailures + interpreters - runs))
  fi

  echo "actualFailures:${actualFailures}"
  echo "totalTests:${totalTests}"
  echo "expectedFailures:0"
}

# The extension lands in the packaged tree without an execute bit too, and a
# pax that cannot load its own module is worse than a failed build.
zopen_post_install() {
  for _so in "${ZOPEN_INSTALL_DIR}"/lib/python/cryptography/hazmat/bindings/*.so; do
    [ -f "${_so}" ] || continue
    chmod +x "${_so}"
    chtag -b "${_so}"
    printInfo "Made $(basename "${_so}") loadable"
  done
}

zopen_append_to_env() {
  cat <<ZZ
PYTHONPATH="\${PYTHONPATH}:\${PWD}/lib/python"
export PYTHONPATH="\$(deleteDuplicateEntries "\$PYTHONPATH" ":")"
ZZ
}

zopen_append_to_validate_install() {
  echo "python -c \"import cryptography; print('cryptography', cryptography.__version__)\""
}
